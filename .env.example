# 666SOUNDsDESIGn RadioBotAI HYBRID v3.3.x
# Kopieren nach .env und echte Werte nur lokal/Host/Cloudflare-Secrets eintragen.

# Discord Pflicht
DISCORD_TOKEN=
DISCORD_OWNER_ID=
DISCORD_GUILD_ID=
RADIO_VOICE_CHANNEL_ID=

# Bot Runtime
HEALTH_PORT=8080
AUTO_JOIN_ON_READY=true
DEFAULT_PRESET=1

# Geschützter RadioBotAI Worker
RADIOBOTAI_WORKER_URL=https://666radiobotai.666soundsdesign-broadcaster.com
RADIOBOTAI_WORKER_SKIP_PATH=/radio/autodj/skip
RADIOBOTAI_WORKER_STATUS_PATH=/radio/autodj/status
RADIOBOTAI_WORKER_TOKEN=
RADIOBOTAI_WORKER_GATE_CODE=

# Admin Worker Fallback — default AUS lassen, bis geschützt verifiziert
RADIO_ADMIN_DIRECT_FALLBACK=false
RADIO_ADMIN_WORKER_URL=https://666myidjstreamadmin.666soundsdesign-broadcaster.com
RADIO_ADMIN_WORKER_FALLBACK_URL=https://666myidjstreamadmin.digital-underground-connected.workers.dev
RADIO_ADMIN_WORKER_SKIP_PATH=/admin/autodj/skip
RADIO_ADMIN_WORKER_TOKEN=

# Optionaler direkter SHOUTcast-/MyIDJ-Notfallpfad
AUTO_DJ_SKIP_MODE=worker
AUTO_DJ_SKIP_COOLDOWN=8
AUTO_DJ_HTTP_TIMEOUT=12
AUTO_DJ_VERIFY_SSL=true
SHOUTCAST_ADMIN_URL=
SHOUTCAST_SID=1
SHOUTCAST_PASSWORD_IN_QUERY=false
AUTO_DJ_ADMIN_USER=
AUTO_DJ_ADMIN_PASSWORD=

# WebRadio Player Alert / Messenger
PLAYER_ALERT_WORKER_URL=https://666radiobotai.666soundsdesign-broadcaster.com
PLAYER_ALERT_TOKEN=
RENDER_ALERT_URL=
RENDER_ALERT_DIRECT_FALLBACK=false

# Lokaler AutoDJ
LOCAL_AUTODJ_MUSIC_DIR=music/666SOUNDsDESIGn
LOCAL_AUTODJ_GUEST_DIR=music/Guest-Mixes
